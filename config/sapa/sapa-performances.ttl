  sh:nodeKind sh:IRI;
  sh:class crm:E22_Man-Made_Object;
  skos:inScheme <http://shapes.performing-arts.ch/performances>;
  skos:topConceptOf <http://shapes.performing-arts.ch/performances> .

spao-pf:Performance_Serie_P9_consists_of a skos:Concept;
  sh:path crm:P9_consists_of;
  sh:name "consists of (participation)"@en;
  sh:description "Il s'agit de la relation entre une série de représentations et les activités spécifiques qui en permettent la réalisation."@fr;
  skos:editorialNote """Toutes les singles sont liées à une série:

PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/>
PREFIX schema: <http://schema.org/>
SELECT ?this
WHERE {
 ?this a frbroo:F31_Performance .
 ?this schema:additionalType <http://vocab.performing-arts.ch/hlsin> .
 FILTER NOT EXISTS { 
 ?serie a frbroo:F31_Performance .
 ?serie schema:additionalType <http://vocab.performing-arts.ch/hlser> .
 ?serie crm:P9_consists_of ?this .
 }
}"""@en;
  sh:nodeKind sh:IRI;
  sh:class crm:E7_Activity;
  sh:node spao-pf:Activity_Participation;
  skos:inScheme <http://shapes.performing-arts.ch/performances>;
  skos:topConceptOf <http://shapes.performing-arts.ch/performances> .

spao-pf:Performance_Serie_R25_performed a skos:Concept;
  sh:path frbroo:R25_performed;
  sh:name "performed"@en;
  sh:description "Il s'agit de la relation entre une série de représentations et la production des arts de la scène à laquelle elle donne aux publics accès."@fr;
  skos:editorialNote """Toutes les séries sont liées à un plan:

PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/>
PREFIX schema: <http://schema.org/>
SELECT ?this
WHERE {
 ?this a frbroo:F31_Performance .
 ?this schema:additionalType <http://vocab.performing-arts.ch/hlser> .
 FILTER NOT EXISTS { 
 ?this frbroo:R25_performed ?plan
 }
}"""@en;
  sh:minCount "1"^^xsd:integer;
  sh:maxCount "1"^^xsd:integer;
  sh:nodeKind sh:IRI;
  sh:class frbroo:F25_Performance_Plan;
  skos:inScheme <http://shapes.performing-arts.ch/performances>;
  skos:topConceptOf <http://shapes.performing-arts.ch/performances> .

