_:a404a6ca62e042adb3481792f94c51827 rdf:first rdf:type;
  rdf:rest rdf:nil .

spao-pf:F20_Performance_Work a sh:NodeShape;
  sh:targetClass frbroo:F20_Performance_Work;
  rdfs:label "Performance Work"@en;
  skos:definition "Il s'agit d'une partie d'une production des arts de la scène. Y sont précisés les langues parlés et celles des sous-titres, ainsi que le genre artsitique de rattachement de la production."@en;
  sh:closed "true"^^xsd:boolean;
  sh:ignoredProperties _:a404a6ca62e042adb3481792f94c51828;
  foaf:depiction spao-pf:Performative_Work;
  shacl-play:background-color "FDDE34";
