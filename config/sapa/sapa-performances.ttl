    spao-pf:F26_Recording_R14_incorporates, spao-pf:F26_Recording_seeAlso .

_:a404a6ca62e042adb3481792f94c51829 rdf:first rdf:type;
  rdf:rest rdf:nil .

spao-pf:Creation_of_Performance_Plan a sh:NodeShape;
  rdfs:label "Expression creation: Performance Plan"@en;
  sh:target spao-pf:Creation_of_Performance_Plan-target;
  skos:definition "Cette activité créatice est à l'origine d'une production des arts de la scène. Elle est constituée d'activités créatrices spécifiques."@en;
  sh:closed "true"^^xsd:boolean;
  sh:ignoredProperties _:a404a6ca62e042adb3481792f94c518210;
