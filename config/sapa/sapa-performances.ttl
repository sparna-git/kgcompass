spao-pf:F25_Performance_Plan a sh:NodeShape;
  sh:targetClass frbroo:F25_Performance_Plan;
  rdfs:label "Performance Plan"@en;
  skos:definition "Il s'agit d'une production des arts de la scène. Elle se distingue de ses séries de représentations, ou des représentations elles-mêmes. Elle est constituée d'une activité créatrice générique et d'une sous-entité (performance Work)."@en;
  sh:closed "true"^^xsd:boolean;
  sh:ignoredProperties _:a404a6ca62e042adb3481792f94c51823;
  foaf:depiction spao-pf:Performative_Work;
  shacl-play:background-color "FDDE34";
  sh:property spao-pf:F25_Performance_Plan_comment, spao-pf:F25_Performance_Plan_hasMusicTitle,
    spao-pf:F25_Performance_Plan_label, spao-pf:F25_Performance_Plan_P102_has_title, spao-pf:F25_Performance_Plan_P1_is_identified_by,
    spao-pf:F25_Performance_Plan_P67_is_referred_to_by, spao-pf:F25_Performance_Plan_R14_incorporates,
    spao-pf:F25_Performance_Plan_sameAs .

_:a404a6ca62e042adb3481792f94c51823 rdf:first rdf:type;
  rdf:rest rdf:nil .

spao-pf:Single_Performance a sh:NodeShape;
  rdfs:label "Performance Single"@en;
  sh:target spao-pf:Single_Performance-target;
  skos:definition "A single performance is a performance that does not consists_of other performances. Il s'agit d'un événement de type représentation. Elle correspond à un moment dans une journée donnée (par exemple une matinée ou une soirée). Elle peut être caractérisée par sa place dans la série de représentations à laquelle elle appartient (exemple \"première\" etc.). Elle peut être aussi être caractérisée vis-à-vis de l'ensemble des représentations (par exemple : \"première mondiale\", \"première en suisse\", ect.)."@en;
  sh:closed "true"^^xsd:boolean;
  sh:ignoredProperties _:a404a6ca62e042adb3481792f94c51824;
  foaf:depiction spao-pf:Performances;
  shacl-play:background-color "83DDFF";
  sh:property spao-pf:Single_Performance_P9i_forms_part_of, spao-pf:Single_Performance_label,
    spao-pf:Single_Performance_P102_has_title, spao-pf:Single_Performance_P2_has_type,
    spao-pf:Single_Performance_P4_has_time-span, spao-pf:Single_Performance_P67i_is_referred_to_by,
    spao-pf:Single_Performance_additionalType .

spao-pf:Single_Performance-target sh:select """PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/>
PREFIX schema: <http://schema.org/>
SELECT $this
WHERE {
 $this a frbroo:F31_Performance .
 $this schema:additionalType <http://vocab.performing-arts.ch/hlsin> .
}""" .

_:a404a6ca62e042adb3481792f94c51824 rdf:first rdf:type;
  rdf:rest rdf:nil .

spao-pf:Performance_Serie a sh:NodeShape;
  rdfs:label "Performance Serie"@en;
  sh:target spao-pf:Performance_Serie-target;
  skos:definition "A performance serie consists of other performances. Il s'agit d'une série de représentations qui est donnée dans une lieu déterminé durant une période habituellement consécutive. Elle s'inscrit dans une saison théâtrale donnée. Elle donne accès aux publics à une production des arts de la scène. Parmi les activités créatrices spécifiques qui lui sont rattachées directement on retrouve l'ensemble des personnes et groupes impliquées dans sa réalisation (exemple les actrices et les acteurs)."@en;
  sh:closed "true"^^xsd:boolean;
  sh:ignoredProperties _:a404a6ca62e042adb3481792f94c51825;
  foaf:depiction spao-pf:Performances;
  shacl-play:background-color "83DDFF";
  sh:property spao-pf:Performance_Serie_label, spao-pf:Performance_Serie_P102_has_title,
    spao-pf:Performance_Serie_P2_has_type, spao-pf:Performance_Serie_P67i_is_referred_to_by,
    spao-pf:Performance_Serie_P8_took_place_on_or_within, spao-pf:Performance_Serie_P9_consists_of,
    spao-pf:Performance_Serie_R25_performed, spao-pf:Performance_Serie_additionalType,
    spao-pf:Performance_Serie_P10_falls_within .

spao-pf:Performance_Serie-target sh:select """PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/>
PREFIX schema: <http://schema.org/>
SELECT $this
WHERE {
 $this a frbroo:F31_Performance .
 $this schema:additionalType <http://vocab.performing-arts.ch/hlser> .
}""" .

_:a404a6ca62e042adb3481792f94c51825 rdf:first rdf:type;
  rdf:rest rdf:nil .

spao-pf:Performance_Standalone a sh:NodeShape;
  rdfs:label "Performance Stand-alone"@en;
  sh:target spao-pf:Performance_Standalone-target;
  skos:definition "A stand-alone performance with no predefined Performance serie, e.g. a workshop, improvisation, etc. Il s'agit d'une représentation isolée, sans lien avec une série de représentation ou une production donnée."@en;
  sh:closed "true"^^xsd:boolean;
  sh:ignoredProperties _:a404a6ca62e042adb3481792f94c51826;
  foaf:depiction spao-pf:Performances;
  shacl-play:background-color "83DDFF";
  sh:property spao-pf:Performance_Standalone_P102_has_title, spao-pf:Performance_Standalone_P2_has_type,
    spao-pf:Performance_Standalone_P9_consists_of, spao-pf:Performance_Standalone_P67i_is_referred_to_by,
    spao-pf:Performance_Standalone_label, spao-pf:Performance_Standalone_P4_has_time-span,
    spao-pf:Performance_Standalone_P8_took_place_on_or_within, spao-pf:Performance_Standalone_hasMusicTitle,
    spao-pf:Performance_Standalone_additionalType .

spao-pf:Performance_Standalone-target sh:select """PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/>
PREFIX schema: <http://schema.org/>
SELECT $this
WHERE {
 $this a frbroo:F31_Performance .
 $this schema:additionalType <http://vocab.performing-arts.ch/hlsta> .
}""" .

_:a404a6ca62e042adb3481792f94c51826 rdf:first rdf:type;
  rdf:rest rdf:nil .

spao-pf:F22_Self-Contained_Expression a sh:NodeShape;
  sh:targetClass frbroo:F22_Self-Contained_Expression;
  rdfs:label "Non-Performative Expression"@en;
  skos:definition "In this class we can find URI in /u/ and /k/.Il s'agit des oeuvres non performatives comme les pièces de théâtre, les livrets d'opéra, les romans sur lesquels se sont basés les artistes pour créer la production d'art de la scène."@en;
  sh:closed "true"^^xsd:boolean;
  sh:ignoredProperties _:a404a6ca62e042adb3481792f94c51827;
  foaf:depiction spao-pf:Non-Performative_Work;
  shacl-play:background-color "FDDE34";
