spao-pf:F25_Performance_Plan_label a skos:Concept;
  sh:path rdfs:label;
  sh:name "label"@en;
  sh:description "Il s'agit de la relation entre une production des arts de la scène et un libellé général qui permet de l'identifier."@fr;
  skos:editorialNote """La label n'est pas obligatoire ? liste des PP sans label :

PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?x WHERE {
 ?x a frbroo:F25_Performance_Plan .
 FILTER NOT EXISTS {?x rdfs:label ?l}
} 

Tickets https://github.com/sapa/performing-arts-ch-cleaning/issues/87"""@en;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:string;
  skos:inScheme <http://shapes.performing-arts.ch/performances> .

