    spao-pf:F20_Performance_Work_P2_has_type, spao-pf:F20_Performance_Work_R12_is_realised_in,
    spao-pf:F20_Performance_Work_subtitleLanguage .

_:a404a6ca62e042adb3481792f94c51828 rdf:first rdf:type;
  rdf:rest rdf:nil .

spao-pf:F26_Recording a sh:NodeShape;
  sh:targetClass frbroo:F26_Recording;
  rdfs:label "Recording"@en;
  skos:definition "Il s'agit d'un enregistrement vidéo ou audio d'une représentation. Il est souvent lié aux documents présents dans les collections conservées par la Fondation SAPA."@en;
  sh:closed "true"^^xsd:boolean;
  sh:ignoredProperties _:a404a6ca62e042adb3481792f94c51829;
