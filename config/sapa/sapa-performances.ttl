spao-pf:Performance_Serie_label a skos:Concept;
  sh:path rdfs:label;
  sh:name "label"@en;
  sh:description "Il s'agit de la relation entre une série de représentations et un libellé d'ordre général qui permet de l'identifier."@fr;
  skos:editorialNote """Bizarre qu'on n'ait pas une cardinalité minimale.

Requête SPARQL:

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/>
PREFIX spav: <http://vocab.performing-arts.ch/>
SELECT ?x
WHERE {
 ?x a frbroo:F31_Performance
 FILTER NOT EXISTS { ?x rdfs:label ?l }
}
LIMIT 1000

On met une cardinalité minimale à 1"""@en;
  sh:minCount "1"^^xsd:integer;
  sh:maxCount "1"^^xsd:integer;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:string;
  skos:inScheme <http://shapes.performing-arts.ch/performances>;
  skos:topConceptOf <http://shapes.performing-arts.ch/performances> .

