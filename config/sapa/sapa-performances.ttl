  sh:path crm:P2_has_type;
  sh:name "has type"@en;
  sh:description "Il s'agit de la relation entre une série de représentations et des types qui en précisent la nature."@fr;
  sh:nodeKind sh:IRI;
  sh:class skos:Concept;
  sh:node spao-pf:Performance_Type;
  sh:group _:a404a6ca62e042adb3481792f94c518219;
  skos:inScheme <http://shapes.performing-arts.ch/performances>;
  skos:topConceptOf <http://shapes.performing-arts.ch/performances> .

_:a404a6ca62e042adb3481792f94c518219 rdfs:label "" .

spao-pf:Performance_Serie_P67i_is_referred_to_by a skos:Concept;
  sh:path crm:P67i_is_referred_to_by;
  sh:name "is referred to by"@en;
  sh:description "Il s'agit de la relation entre une série de représentations et une description sur l'un de ses aspects."@fr;
  skos:editorialNote """Attention, l'URI de la propriété est fausse. Cela devrait être P67i car c'est une propriété inverse.

20240626: j'ajuste en metttant le \"i\" dans l' URI."""@en;
  sh:nodeKind sh:IRI;
  sh:class crm:E33_Linguistic_Object;
  sh:node spao-pf:E33_Linguistic_Object;
  skos:inScheme <http://shapes.performing-arts.ch/performances>;
  skos:topConceptOf <http://shapes.performing-arts.ch/performances> .

spao-pf:Performance_Serie_P8_took_place_on_or_within a skos:Concept;
  sh:path crm:P8_took_place_on_or_within;
  sh:name "took place on or within"@en;
