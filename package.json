    "build:lib": "tsc",
    "build": "npm run build:lib"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "kgreconcile": "file:../kgreconcile/kgreconcile-0.1.0.tgz",
    "rdf-data-factory": "^1.1.2",
    "rdf-shacl-commons": "0.3.5",
    "reflect-metadata": "^0.2.2",
    "sparqljs": "^3.4.0",
    "tsyringe": "^4.10.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.1",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.17",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^18.17.0",
    "@types/sparqljs": "^3.1.12",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
